<UserControl x:Class="CoreEngine.Hub.HubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CoreEngine.Hub"
             Width="1280" Height="720"
             FontFamily="Segoe UI" FontSize="14" Foreground="#E4E7EB"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!--
      CoreEngine Hub's one page, laid out as HoYoPlay's page for a game: the game's picture over the whole window,
      the column of games at the left, the window's buttons at the top right, what is new at the bottom left, and at
      the bottom right the one big button that is always the next step, with the game's menu beside it. The colours
      are the game's own (docs/research/R6: ink #0C0E13, blue #82D8FF for what is chosen, green #55E414 to go, amber
      #FFBA52 for problems), the labels in Bahnschrift as in the game.
    -->
    <UserControl.Resources>
        <FontFamily x:Key="Heading">Bahnschrift SemiBold Condensed, Bahnschrift, Segoe UI</FontFamily>
        <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="Shown" />
        <local:UpperConverter x:Key="Upper" />
        <local:IndexIsConverter x:Key="IndexIs" />

        <!-- The big button: green to go; quiet (dark) for Pause and while busy -->
        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="Background" Value="#55E414" />
            <Setter Property="Foreground" Value="#0C0E13" />
            <Setter Property="BorderBrush" Value="#55E414" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource Heading}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#72F23A" />
                    <Setter Property="BorderBrush" Value="#72F23A" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#46C20F" />
                </Trigger>
                <DataTrigger Binding="{Binding MainQuiet}" Value="True">
                    <Setter Property="Background" Value="#1C2129" />
                    <Setter Property="BorderBrush" Value="#3A4452" />
                    <Setter Property="Foreground" Value="#E4E7EB" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding MainQuiet}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#262C35" />
                    <Setter Property="BorderBrush" Value="#526072" />
                </MultiDataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#161A20" />
                    <Setter Property="BorderBrush" Value="#2A313B" />
                    <Setter Property="Foreground" Value="#8A95A3" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Square dark buttons: the game's menu (⋯) -->
        <Style x:Key="SquareButton" TargetType="Button">
            <Setter Property="Background" Value="#E60F1116" />
            <Setter Property="Foreground" Value="#E4E7EB" />
            <Setter Property="BorderBrush" Value="#3A4452" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#262C35" />
                    <Setter Property="BorderBrush" Value="#526072" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The window's buttons at the top right -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="#E4E7EB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource Glyphs}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A line of the game's menu -->
        <Style x:Key="MenuLine" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="#E4E7EB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#5C6673" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The menu's Uninstall: red, and grey like the others while it waits (a colour set on the button would stay red) -->
        <Style x:Key="MenuLineDanger" TargetType="Button" BasedOn="{StaticResource MenuLine}">
            <Setter Property="Foreground" Value="#FF8A8E" />
        </Style>

        <!-- Buttons in the dialogs -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Foreground" Value="#E4E7EB" />
            <Setter Property="Background" Value="#1C2129" />
            <Setter Property="BorderBrush" Value="#3A4452" />
            <Setter Property="FontFamily" Value="{StaticResource Heading}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#262C35" />
                    <Setter Property="BorderBrush" Value="#526072" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogGo" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#55E414" />
            <Setter Property="BorderBrush" Value="#55E414" />
            <Setter Property="Foreground" Value="#0C0E13" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#72F23A" />
                    <Setter Property="BorderBrush" Value="#72F23A" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#161A20" />
                    <Setter Property="BorderBrush" Value="#2A313B" />
                    <Setter Property="Foreground" Value="#6B7684" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogDanger" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#C8383D" />
            <Setter Property="BorderBrush" Value="#C8383D" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5484D" />
                    <Setter Property="BorderBrush" Value="#E5484D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Choices in the settings, as chips (one of several) -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="Background" Value="#161A20" />
            <Setter Property="BorderBrush" Value="#2E3642" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#526072" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#1A82D8FF" />
                    <Setter Property="BorderBrush" Value="#82D8FF" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#E4E7EB" />
            <Setter Property="Background" Value="#161A20" />
            <Setter Property="BorderBrush" Value="#2E3642" />
            <Setter Property="CaretBrush" Value="#82D8FF" />
            <Setter Property="SelectionBrush" Value="#82D8FF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#82D8FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E7EB" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="#526072" Background="#161A20">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource Glyphs}" FontSize="12" Foreground="#0C0E13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#82D8FF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#82D8FF" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Heading}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#A8B2BD" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="DialogPanel" TargetType="Border">
            <Setter Property="Width" Value="540" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#0F1116" />
            <Setter Property="BorderBrush" Value="#2A313B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="30,26,30,26" />
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True" Background="#0C0E13">
        <!-- The game's picture over the whole window, darker where the words are -->
        <Image Source="Assets/keyart.jpg" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E00C0E13" Offset="0" />
                    <GradientStop Color="#990C0E13" Offset="0.25" />
                    <GradientStop Color="#000C0E13" Offset="0.55" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#990C0E13" Offset="0" />
                    <GradientStop Color="#000C0E13" Offset="0.16" />
                    <GradientStop Color="#000C0E13" Offset="0.55" />
                    <GradientStop Color="#F00C0E13" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- The column of games at the left, as HoYoPlay's: the Hub's mark, then the game (chosen) -->
        <Border Width="76" HorizontalAlignment="Left" Background="#F00C0E13" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Top" Margin="0,20,0,0">
                <Viewbox Width="34" Height="34">
                    <Canvas Width="24" Height="24">
                        <Rectangle Canvas.Left="5.5" Canvas.Top="5.5" Width="13" Height="13" RadiusX="2.2" RadiusY="2.2" Stroke="#82D8FF" StrokeThickness="1.8" />
                        <Rectangle Canvas.Left="9.25" Canvas.Top="9.25" Width="5.5" Height="5.5" RadiusX="0.8" RadiusY="0.8" Fill="#82D8FF" />
                        <Path Stroke="#82D8FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M9,1.8 V5.2 M15,1.8 V5.2 M9,18.8 V22.2 M15,18.8 V22.2 M1.8,9 H5.2 M1.8,15 H5.2 M18.8,9 H22.2 M18.8,15 H22.2" />
                    </Canvas>
                </Viewbox>
                <Rectangle Height="1" Width="36" Fill="#26FFFFFF" Margin="0,20,0,18" />
                <Grid Width="76" Height="56" ToolTip="CoreEngine">
                    <Rectangle Width="3" Height="26" Fill="#82D8FF" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" />
                    <Border Width="54" Height="54" CornerRadius="10" BorderBrush="#82D8FF" BorderThickness="2" Background="#0C0E13">
                        <Border CornerRadius="8" Margin="2">
                            <Border.Background>
                                <ImageBrush ImageSource="Assets/keyart.jpg" Stretch="UniformToFill" Viewbox="0.3,0.18,0.4,0.62" ViewboxUnits="RelativeToBoundingBox" />
                            </Border.Background>
                        </Border>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- The top bar: drag the window by it; settings, minimise and close at the right -->
        <Grid x:Name="TopBar" Height="44" VerticalAlignment="Top" Margin="76,0,0,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource WindowButton}" Command="{Binding SettingsCommand}" ToolTip="{Binding T[tip.settings]}" Content="&#xE713;" FontSize="15" />
                <Button Style="{StaticResource WindowButton}" Command="{Binding MinimizeCommand}" ToolTip="{Binding T[tip.minimize]}" Content="&#xE921;" />
                <Button Style="{StaticResource CloseButton}" Command="{Binding CloseCommand}" ToolTip="{Binding T[tip.close]}" Content="&#xE8BB;" />
            </StackPanel>
        </Grid>

        <!-- The game's name on its picture, as HoYoPlay shows a game's logo -->
        <StackPanel Margin="118,78,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <TextBlock Text="COREENGINE" FontFamily="{StaticResource Heading}" FontSize="66" Foreground="White">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{Binding T[tagline]}" FontSize="16" Foreground="#E4E7EB" MaxWidth="470" TextWrapping="Wrap" Margin="4,2,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.7" Color="Black" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- What is new, at the bottom left -->
        <Border Margin="118,0,0,44" Width="450" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="8"
                Background="#EB0F1116" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="22,18,22,18">
            <StackPanel>
                <TextBlock Text="{Binding NotesTitle, Converter={StaticResource Upper}}" FontFamily="{StaticResource Heading}" FontSize="16" Foreground="#82D8FF" TextTrimming="CharacterEllipsis" />
                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <Ellipse Width="5" Height="5" Fill="#82D8FF" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="1,8,11,0" />
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#E4E7EB" FontSize="14" LineHeight="20" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- The next step, at the bottom right: the progress, the big button with the game's menu, the status -->
        <StackPanel Width="420" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,44,40">
            <Grid Visibility="{Binding ProgressVisible, Converter={StaticResource Shown}}" Margin="2,0,2,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding ProgressLeft}" FontSize="15" FontWeight="SemiBold" Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="Black" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{Binding ProgressRight}" FontSize="13" Foreground="#C9D1D9" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="Black" />
                    </TextBlock.Effect>
                </TextBlock>
                <ProgressBar Grid.Row="1" Height="6" Margin="0,9,0,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="3" Background="#40FFFFFF" />
                                <Border x:Name="PART_Indicator" CornerRadius="3" Background="#55E414" HorizontalAlignment="Left" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </Grid>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource MainButton}" Width="344" Height="66" Command="{Binding MainCommand}" IsEnabled="{Binding MainEnabled}"
                        Content="{Binding MainText, Converter={StaticResource Upper}}" />
                <Button Style="{StaticResource SquareButton}" Width="66" Height="66" Margin="10,0,0,0" Command="{Binding MenuCommand}" ToolTip="{Binding T[menu]}">
                    <TextBlock Text="&#xE712;" FontFamily="{StaticResource Glyphs}" FontSize="18" />
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Margin="3,11,0,0" FontSize="13" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#C9D1D9" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusWarn}" Value="True">
                                <Setter Property="Foreground" Value="#FFBA52" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.8" Color="Black" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- The game's menu, above its button; a click anywhere else closes it -->
        <Grid Visibility="{Binding MenuOpen, Converter={StaticResource Shown}}">
            <Button Command="{Binding CloseDialogCommand}" Background="Transparent" Cursor="Arrow">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Width="280" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,44,146" Background="#F70F1116"
                    BorderBrush="#2E3642" BorderThickness="1" CornerRadius="8" Padding="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding T[menu], Converter={StaticResource Upper}}" FontFamily="{StaticResource Heading}" FontSize="14" Foreground="#8A95A3" Margin="14,8,0,6" />
                    <Button Style="{StaticResource MenuLine}" Command="{Binding RepairCommand}" IsEnabled="{Binding CanChangeGame}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90F;" FontFamily="{StaticResource Glyphs}" FontSize="15" Width="28" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding T[menu.repair]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuLine}" Command="{Binding OpenFolderCommand}" IsEnabled="{Binding IsInstalled}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource Glyphs}" FontSize="15" Width="28" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding T[menu.folder]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuLine}" Command="{Binding LocateCommand}" IsEnabled="{Binding CanFindGame}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Glyphs}" FontSize="15" Width="28" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding T[menu.locate]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Height="1" Fill="#1FFFFFFF" Margin="10,4" />
                    <Button Style="{StaticResource MenuLineDanger}" Command="{Binding UninstallCommand}" IsEnabled="{Binding CanChangeGame}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Glyphs}" FontSize="15" Width="28" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding T[menu.uninstall]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Install: where, how much space, a desktop shortcut -->
        <Grid Background="#A6000000" Visibility="{Binding InstallOpen, Converter={StaticResource Shown}}">
            <Border Style="{StaticResource DialogPanel}">
                <StackPanel>
                    <TextBlock Text="{Binding T[install.title], Converter={StaticResource Upper}}" Style="{StaticResource DialogTitle}" />
                    <TextBlock Text="{Binding T[install.folder]}" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Command="{Binding ChangeFolderCommand}" Content="{Binding T[install.change], Converter={StaticResource Upper}}" MinWidth="0" Height="40" />
                        <TextBox x:Name="PathBox" Text="{Binding InstallDir, Mode=OneWay}" IsReadOnly="True" />
                    </DockPanel>
                    <TextBlock Text="{Binding InstallSpace}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#A8B2BD" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InstallSpaceOk}" Value="False">
                                        <Setter Property="Foreground" Value="#FFBA52" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <CheckBox Content="{Binding T[install.shortcut]}" IsChecked="{Binding DesktopShortcut}" Margin="0,20,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                        <Button Style="{StaticResource DialogGo}" Command="{Binding InstallCommand}" IsEnabled="{Binding InstallSpaceOk}" Content="{Binding T[install.go], Converter={StaticResource Upper}}" />
                        <Button Style="{StaticResource DialogButton}" Command="{Binding CloseDialogCommand}" Content="{Binding T[cancel], Converter={StaticResource Upper}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The Hub's settings -->
        <Grid Background="#A6000000" Visibility="{Binding SettingsOpen, Converter={StaticResource Shown}}">
            <Border Style="{StaticResource DialogPanel}" Width="600">
                <StackPanel>
                    <TextBlock Text="{Binding T[settings], Converter={StaticResource Upper}}" Style="{StaticResource DialogTitle}" />
                    <TextBlock Text="{Binding T[settings.language]}" Style="{StaticResource FieldLabel}" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" Content="English" IsChecked="{Binding LanguageIndex, Converter={StaticResource IndexIs}, ConverterParameter=0}" />
                        <RadioButton Style="{StaticResource Chip}" Content="Oʻzbekcha" IsChecked="{Binding LanguageIndex, Converter={StaticResource IndexIs}, ConverterParameter=1}" />
                        <RadioButton Style="{StaticResource Chip}" Content="Русский" IsChecked="{Binding LanguageIndex, Converter={StaticResource IndexIs}, ConverterParameter=2}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding T[settings.speed]}" Style="{StaticResource FieldLabel}" Margin="0,10,0,8" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" Content="{Binding T[settings.noLimit]}" IsChecked="{Binding SpeedIndex, Converter={StaticResource IndexIs}, ConverterParameter=0}" />
                        <RadioButton Style="{StaticResource Chip}" Content="1 MB/s" IsChecked="{Binding SpeedIndex, Converter={StaticResource IndexIs}, ConverterParameter=1}" />
                        <RadioButton Style="{StaticResource Chip}" Content="2 MB/s" IsChecked="{Binding SpeedIndex, Converter={StaticResource IndexIs}, ConverterParameter=2}" />
                        <RadioButton Style="{StaticResource Chip}" Content="5 MB/s" IsChecked="{Binding SpeedIndex, Converter={StaticResource IndexIs}, ConverterParameter=3}" />
                        <RadioButton Style="{StaticResource Chip}" Content="10 MB/s" IsChecked="{Binding SpeedIndex, Converter={StaticResource IndexIs}, ConverterParameter=4}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding T[settings.afterStart]}" Style="{StaticResource FieldLabel}" Margin="0,10,0,8" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Chip}" Content="{Binding T[settings.close]}" IsChecked="{Binding AfterStartIndex, Converter={StaticResource IndexIs}, ConverterParameter=0}" />
                        <RadioButton Style="{StaticResource Chip}" Content="{Binding T[settings.minimize]}" IsChecked="{Binding AfterStartIndex, Converter={StaticResource IndexIs}, ConverterParameter=1}" />
                        <RadioButton Style="{StaticResource Chip}" Content="{Binding T[settings.keep]}" IsChecked="{Binding AfterStartIndex, Converter={StaticResource IndexIs}, ConverterParameter=2}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding T[settings.source]}" Style="{StaticResource FieldLabel}" Margin="0,10,0,8" />
                    <TextBox Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding T[settings.sourceNote]}" FontSize="12" Foreground="#8A95A3" Margin="0,6,0,0" />
                    <DockPanel Margin="0,24,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Command="{Binding CloseSettingsCommand}" Content="{Binding T[ok], Converter={StaticResource Upper}}" />
                        <TextBlock Text="{Binding HubVersion}" FontSize="12" Foreground="#6B7684" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Uninstall: are you sure -->
        <Grid Background="#A6000000" Visibility="{Binding UninstallOpen, Converter={StaticResource Shown}}">
            <Border Style="{StaticResource DialogPanel}">
                <StackPanel>
                    <TextBlock Text="{Binding T[uninstall.title], Converter={StaticResource Upper}}" Style="{StaticResource DialogTitle}" />
                    <TextBlock Text="{Binding UninstallText}" TextWrapping="Wrap" Foreground="#C9D1D9" LineHeight="20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                        <Button Style="{StaticResource DialogDanger}" Command="{Binding ConfirmUninstallCommand}" Content="{Binding T[uninstall.go], Converter={StaticResource Upper}}" />
                        <Button Style="{StaticResource DialogButton}" Command="{Binding CloseDialogCommand}" Content="{Binding T[cancel], Converter={StaticResource Upper}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- A message: a repair's result, an error -->
        <Grid Background="#A6000000" Visibility="{Binding MessageOpen, Converter={StaticResource Shown}}">
            <Border Style="{StaticResource DialogPanel}">
                <StackPanel>
                    <TextBlock Text="{Binding MessageTitle, Converter={StaticResource Upper}}" Style="{StaticResource DialogTitle}" />
                    <TextBlock Text="{Binding MessageText}" TextWrapping="Wrap" Foreground="#C9D1D9" LineHeight="20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                        <Button Style="{StaticResource DialogButton}" Command="{Binding CloseDialogCommand}" Content="{Binding T[ok], Converter={StaticResource Upper}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
