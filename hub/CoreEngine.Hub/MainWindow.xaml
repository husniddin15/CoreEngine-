<Window x:Class="CoreEngine.Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CoreEngine.Hub"
        Title="CoreEngine Hub" Width="1280" Height="720"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#0C0E13" Icon="Assets/hub.ico">
    <!-- No Windows title bar: the Hub draws its own buttons, as HoYoPlay does; Windows 11 still rounds the corners and draws the shadow. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Viewbox Stretch="Uniform">
        <local:HubView />
    </Viewbox>
</Window>
