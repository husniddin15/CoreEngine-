<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless runner: simcli (docs/04-technical-design.md §3). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>simcli</AssemblyName>
    <RootNamespace>CoreEngine.Sim.Cli</RootNamespace>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoreEngine.Sim\CoreEngine.Sim.csproj" />
  </ItemGroup>

</Project>
