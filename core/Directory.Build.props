<Project>
  <!-- Settings shared by every project under core/. -->
  <PropertyGroup>
    <!--
      Build output goes to core/.build/ instead of bin/ and obj/ inside each project, because Unity
      imports core/CoreEngine.Sim as a local package and would otherwise compile the generated files.
      Folders starting with a dot are ignored by Unity.
    -->
    <BaseOutputPath>$(MSBuildThisFileDirectory).build\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>

    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Product>CoreEngine</Product>
    <Company>CoreEngine</Company>
    <Copyright>CoreEngine</Copyright>
  </PropertyGroup>
</Project>
