/* The Garage, the main screen (ADR-0009): dark glass panels over the photographed lab, one accent colour
   (cyan) for selection and one (green) for START. Icons are drawn in code (UI/Icons.cs). */

.garage-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(226, 230, 237);
    font-size: 13px;
}
.icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
}

/* ---- top bar ---- */
.top-bar {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding: 0 16px;
    background-color: rgba(9, 12, 17, 0.82);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.07);
}
.logo {
    flex-direction: row;
    align-items: center;
    margin-right: 22px;
}
.logo-mark {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    color: rgb(79, 193, 255);
}
.app-title {
    -unity-font-style: bold;
    font-size: 15px;
    letter-spacing: 3px;
    color: rgb(244, 246, 250);
}
.nav-button {
    flex-direction: row;
    align-items: center;
    height: 56px;
    margin: 0 2px;
    padding: 0 12px;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(150, 160, 175);
    font-size: 13px;
    transition-duration: 0.12s;
}
.nav-icon {
    width: 16px;
    height: 16px;
    margin-right: 7px;
}
.nav-button:hover {
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.04);
}
.nav-button--active {
    color: rgb(255, 255, 255);
    border-bottom-color: rgb(79, 193, 255);
}
.spacer {
    flex-grow: 1;
}
.arena-group {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}
.arena-label {
    color: rgb(140, 150, 165);
    font-size: 11px;
    letter-spacing: 1px;
    margin-right: 6px;
}
.arena-field {
    width: 190px;
    margin: 0;
}
.arena-field .unity-base-popup-field__input {
    height: 34px;
    padding: 0 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    background-color: rgba(28, 34, 45, 0.9);
}
.arena-field .unity-base-popup-field__text {
    color: rgb(232, 234, 240);
}
.arena-field .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(160, 170, 185);
}
.start-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 40px;
    min-width: 164px;
    margin-right: 16px;
    padding: 0 18px;
    border-width: 1px;
    border-color: rgb(92, 214, 116);
    border-radius: 8px;
    background-color: rgb(40, 158, 68);
    color: rgb(255, 255, 255);
    transition-duration: 0.12s;
}
.start-button:hover {
    background-color: rgb(52, 182, 82);
    scale: 1.03 1.03;
}
.start-icon {
    width: 16px;
    height: 16px;
    margin-right: 9px;
}
.start-label {
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}
.lang-button {
    margin: 0 1px;
    padding: 3px 9px;
    min-width: 38px;
    border-width: 0;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(150, 160, 175);
    font-size: 11px;
}
.lang-button--active {
    background-color: rgb(79, 193, 255);
    color: rgb(12, 16, 22);
}
.icon-button {
    width: 36px;
    height: 36px;
    margin-left: 10px;
    padding: 9px;
    border-width: 0;
    border-radius: 18px;
    background-color: rgba(255, 255, 255, 0.05);
    color: rgb(170, 178, 190);
}
.icon-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: rgb(255, 255, 255);
}

/* ---- middle row ---- */
.middle {
    flex-direction: row;
    flex-grow: 1;
    padding: 16px;
}
.centre {
    flex-grow: 1;
}
.robot-card {
    width: 268px;
    align-self: flex-start;
    padding: 16px 18px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    background-color: rgba(10, 13, 19, 0.86);
}
.card-eyebrow {
    font-size: 10px;
    letter-spacing: 2px;
    color: rgb(79, 193, 255);
}
.card-name {
    margin: 2px 0 8px 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    white-space: normal;
}
.status-chip {
    align-self: flex-start;
    padding: 2px 10px;
    border-radius: 10px;
    background-color: rgba(46, 160, 67, 0.22);
    color: rgb(120, 230, 140);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.status-chip--warn {
    background-color: rgba(255, 176, 50, 0.2);
    color: rgb(255, 200, 100);
}
.card-divider {
    height: 1px;
    margin: 12px 0 8px 0;
    background-color: rgba(255, 255, 255, 0.07);
}
.card-row {
    flex-direction: row;
    align-items: flex-start;
    margin: 4px 0;
}
.card-icon {
    width: 15px;
    height: 15px;
    margin: 1px 8px 0 0;
    color: rgb(110, 122, 140);
}
.card-key {
    width: 64px;
    color: rgb(140, 150, 165);
}
.card-value {
    flex-grow: 1;
    flex-shrink: 1;
    color: rgb(236, 238, 243);
    -unity-text-align: upper-right;
    white-space: normal;
}
.battery-bar {
    height: 6px;
    min-height: 6px;
    margin: 4px 0 6px 23px;
    padding: 0;
}
.battery-bar .unity-progress-bar__container {
    height: 6px;
    min-height: 6px;
    margin: 0;
    padding: 0;
}
.battery-bar .unity-progress-bar__background {
    height: 6px;
    min-height: 6px;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.08);
}
.battery-bar .unity-progress-bar__progress {
    border-width: 0;
    border-radius: 3px;
    background-color: rgb(96, 214, 120);
}
.battery-bar .unity-progress-bar__title-container {
    display: none;
}
.card-warnings {
    margin-top: 8px;
}
.warn-row, .try-row {
    flex-direction: row;
    align-items: flex-start;
    margin: 3px 0;
}
.warn-icon {
    width: 14px;
    height: 14px;
    margin: 1px 7px 0 1px;
    color: rgb(255, 196, 80);
}
.warn-line {
    flex-shrink: 1;
    margin: 1px 0;
    color: rgb(255, 205, 110);
    white-space: normal;
}
.try-line {
    flex-shrink: 1;
    margin: 1px 0;
    color: rgb(190, 150, 255);
    white-space: normal;
}
.ok-line {
    margin: 1px 0;
    color: rgb(110, 220, 130);
    white-space: normal;
}

/* ---- action tiles and side panel ---- */
.right-column {
    width: 300px;
    align-self: flex-start;
}
.actions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}
.action-tile {
    width: 146px;
    min-height: 136px;
    flex-shrink: 0;
    margin: 0 0 8px 0;
    padding: 0;
    overflow: hidden;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    background-color: rgba(10, 13, 19, 0.9);
    color: rgb(170, 200, 225);
    transition-duration: 0.12s;
}
.action-tile:hover {
    border-color: rgba(79, 193, 255, 0.7);
    background-color: rgba(18, 28, 40, 0.96);
    color: rgb(79, 193, 255);
    translate: 0 -2px;
}
/* The card's picture, its icon as a badge on it until and after the picture comes (GaragePartPictures.cs) */
.tile-image {
    width: 100%;
    height: 72px;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.04);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}
.tile-picture {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.tile-icon {
    width: 28px;
    height: 28px;
}
.tile-image--pictured > .tile-icon {
    position: absolute;
    left: 6px;
    top: 6px;
    width: 22px;
    height: 22px;
    padding: 3px;
    border-radius: 6px;
    background-color: rgba(8, 11, 16, 0.78);
    color: rgb(79, 193, 255);
}
/* The words under the picture, without a label's own margins, so three rows of cards fit at 720 lines even in
   Uzbek and Russian, whose names and lines wrap more */
.tile-text {
    padding: 8px 10px 10px 10px;
}
.tile-title {
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(244, 246, 250);
    -unity-text-align: upper-left;
    white-space: normal;
}
.tile-sub {
    margin: 3px 0 0 0;
    padding: 0;
    font-size: 12px;
    color: rgb(188, 197, 210);
    -unity-text-align: upper-left;
    white-space: normal;
}
.side-panel {
    max-height: 500px;
    padding: 12px 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    background-color: rgba(10, 13, 19, 0.86);
}
.side-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}
.back-button {
    width: 30px;
    height: 26px;
    margin-right: 8px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(255, 255, 255);
}
.side-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}
.section-title {
    margin: 8px 0 6px 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(150, 160, 175);
}
.info-text {
    margin: 4px 0 8px 0;
    color: rgb(205, 210, 218);
    white-space: normal;
}
.swatch-grid {
    flex-direction: row;
    flex-wrap: wrap;
}
.swatch-item {
    width: 78px;
    height: 88px;
    margin: 0 4px 6px 0;
    padding: 4px;
    flex-direction: column;
    align-items: center;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.04);
}
.swatch-item:hover {
    background-color: rgba(255, 255, 255, 0.08);
}
.swatch-item--active {
    border-color: rgb(79, 193, 255);
}
.swatch-chip {
    width: 42px;
    height: 32px;
    align-items: flex-end;
    justify-content: flex-end;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 4px;
}
.swatch-lock {
    padding: 0 2px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.6);
    color: rgb(255, 255, 255);
    font-size: 11px;
}
.swatch-name {
    margin-top: 3px;
    font-size: 10px;
    color: rgb(220, 224, 230);
    -unity-text-align: upper-center;
    white-space: normal;
}
.swatch-pack {
    font-size: 9px;
    color: rgb(150, 160, 175);
    -unity-text-align: upper-center;
    white-space: normal;
}
.small-button {
    height: 26px;
    margin: 2px 4px 2px 0;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(79, 193, 255, 0.2);
    color: rgb(255, 255, 255);
}
.small-button:hover {
    background-color: rgba(79, 193, 255, 0.35);
}
.small-button:disabled {
    background-color: rgba(255, 255, 255, 0.05);
    color: rgb(110, 118, 130);
}
.repair-buttons {
    flex-direction: row;
    margin-bottom: 4px;
}
.part-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 3px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}
.part-name {
    flex-shrink: 1;
    margin-right: 8px;
    color: rgb(220, 224, 230);
    white-space: normal;
}
.status-ok {
    color: rgb(110, 220, 130);
}
.status-bad {
    color: rgb(255, 110, 90);
    -unity-font-style: bold;
}

/* ---- robot bar ---- */
.garage-hint-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 142px;
    flex-direction: row;
    justify-content: center;
}
.garage-hint {
    max-width: 78%;
    padding: 4px 14px;
    border-radius: 12px;
    background-color: rgba(8, 10, 14, 0.6);
    color: rgba(225, 230, 238, 0.85);
    font-size: 11px;
    letter-spacing: 0.5px;
    white-space: normal;
    -unity-text-align: middle-center;
}
.robot-bar {
    height: 132px;
    flex-shrink: 0;
    padding: 10px 16px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.07);
    background-color: rgba(9, 12, 17, 0.82);
}
.bar-scroll {
    flex-grow: 1;
}
.bar-scroll .unity-scroll-view__content-container {
    flex-direction: row;
}
.bar-card {
    width: 196px;
    height: 110px;
    margin: 0 10px 0 0;
    padding: 0;
    overflow: hidden;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    background-color: rgb(24, 29, 38);
    transition-duration: 0.12s;
}
.bar-card:hover {
    border-color: rgba(79, 193, 255, 0.5);
}
.bar-card--selected {
    border-color: rgb(79, 193, 255);
}
.bar-thumb {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}
.bar-plate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 6px 10px 7px 10px;
    background-color: rgba(8, 10, 14, 0.72);
}
.bar-name-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}
.bar-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}
.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
}
.status-dot--ready {
    background-color: rgb(96, 214, 120);
}
.status-dot--idle {
    background-color: rgb(120, 128, 140);
}
.bar-sub {
    font-size: 10px;
    color: rgb(150, 160, 175);
}
.bar-new {
    justify-content: center;
    align-items: center;
    border-color: rgba(79, 193, 255, 0.35);
    background-color: rgba(79, 193, 255, 0.05);
}
.bar-new-icon {
    width: 24px;
    height: 24px;
    margin-bottom: 4px;
    color: rgb(79, 193, 255);
}
.bar-new-label {
    font-size: 13px;
    color: rgb(79, 193, 255);
}

/* ---- toast and overlays ---- */
.toast {
    position: absolute;
    top: 60px;
    left: 30%;
    right: 30%;
    padding: 10px 14px;
    border-radius: 6px;
    border-left-width: 3px;
    border-left-color: rgb(255, 196, 80);
    background-color: rgba(30, 36, 48, 0.97);
    color: rgb(255, 255, 255);
    white-space: normal;
    -unity-text-align: middle-center;
}
.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}
.overlay-panel {
    width: 80%;
    height: 82%;
    padding: 12px;
    border-radius: 8px;
    background-color: rgb(24, 28, 36);
}
.overlay-page {
    width: 560px;
    height: auto;
}
.overlay-header {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 34px;
    margin-bottom: 8px;
}
.overlay-title {
    flex-grow: 1;
    -unity-text-align: middle-left;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}
.upload-button {
    height: 28px;
    min-width: 96px;
    margin-right: 6px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgb(46, 160, 67);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}
.code-overlay-editor {
    flex-grow: 1;
}
.code-status-line {
    margin-top: 6px;
    color: rgb(200, 205, 215);
    white-space: normal;
}
.diagnostics {
    height: 72px;
    margin-top: 4px;
}
.diag-line {
    padding-left: 4px;
    font-size: 12px;
    color: rgb(244, 135, 113);
    -unity-text-align: middle-left;
}

/* ---- edit modes: Build, Wire, Body ---- */
.edit-tooltip {
    position: absolute;
    max-width: 340px;
    padding: 5px 8px;
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: rgb(79, 193, 255);
    background-color: rgba(14, 17, 23, 0.95);
    color: rgb(240, 242, 246);
    font-size: 12px;
    white-space: normal;
}
.info-line {
    margin: 1px 0;
    color: rgb(150, 180, 210);
    white-space: normal;
}
.bin-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 3px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}
.bin-text {
    flex-shrink: 1;
    margin-right: 6px;
}
.bin-name {
    color: rgb(232, 234, 240);
    white-space: normal;
}
.bin-sub {
    font-size: 11px;
    color: rgb(150, 160, 175);
    white-space: normal;
}
.part-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}
.palette {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 2px;
}
.palette-chip {
    width: 20px;
    height: 20px;
    margin: 0 4px 4px 0;
    padding: 0;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    background-color: rgb(45, 52, 68);
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
}
.palette-chip--active {
    border-color: rgb(79, 193, 255);
}
.wire-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 2px;
    border-radius: 3px;
}
.wire-row:hover {
    background-color: rgba(255, 255, 255, 0.05);
}
.wire-row--selected {
    background-color: rgba(79, 193, 255, 0.16);
}
.wire-chip {
    width: 10px;
    height: 10px;
    margin-right: 6px;
    border-radius: 5px;
    flex-shrink: 0;
}
.wire-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    color: rgb(220, 224, 230);
    white-space: normal;
}
.wire-remove {
    width: 20px;
    height: 20px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(170, 175, 185);
    font-size: 11px;
}
.wire-remove:hover {
    background-color: rgba(255, 110, 90, 0.3);
    color: rgb(255, 255, 255);
}
.seg-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}
.seg-button {
    height: 24px;
    margin: 0 4px 4px 0;
    padding: 0 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.05);
    color: rgb(210, 215, 225);
    font-size: 12px;
}
.seg-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}
.seg-button--active {
    border-color: rgb(79, 193, 255);
    background-color: rgba(79, 193, 255, 0.22);
    color: rgb(255, 255, 255);
}
.body-slider {
    flex-direction: column;
    margin: 2px 0 4px 0;
}
.body-slider > .unity-label {
    min-width: 0;
    margin: 0 0 1px 0;
    padding: 0;
    font-size: 12px;
    color: rgb(150, 160, 175);
}
.body-slider .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.14);
}
.body-slider .unity-base-slider__dragger {
    border-width: 0;
    background-color: rgb(79, 193, 255);
}
.body-slider .unity-base-slider__text-field {
    width: 52px;
    height: 22px;
    margin: 0 0 0 6px;
}
.body-slider .unity-base-text-field__input {
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    background-color: rgb(30, 36, 48);
    color: rgb(232, 234, 240);
    padding: 0 4px;
    -unity-text-align: middle-right;
}
.body-toggle {
    margin: 6px 0 2px 0;
}
.body-toggle > .unity-label {
    min-width: 0;
    color: rgb(220, 224, 230);
}
.body-readout {
    margin-top: 6px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
}
.pin-tag {
    position: absolute;
    padding: 0 2px;
    border-radius: 2px;
    background-color: rgba(14, 17, 23, 0.8);
    color: rgb(240, 242, 246);
    font-size: 10px;
    white-space: nowrap;
    transform-origin: left center;
    translate: 0 -50%;
}
.pin-tag--flip {
    transform-origin: right center;
    translate: -100% -50%;
}
.pin-field {
    margin: 2px 0;
}
.pin-field .unity-base-popup-field__input {
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    background-color: rgb(30, 36, 48);
}
.pin-field .unity-base-popup-field__text {
    color: rgb(232, 234, 240);
    font-size: 12px;
}
.pin-field .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(160, 170, 185);
}

/* ---- scroll bars: a thin rounded thumb, no arrow buttons ---- */
.garage-root .unity-scroller--vertical {
    width: 10px;
    min-width: 10px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.garage-root .unity-scroller--horizontal {
    height: 10px;
    min-height: 10px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.garage-root .unity-scroller > .unity-scroller__low-button,
.garage-root .unity-scroller > .unity-scroller__high-button {
    display: none;
}
.garage-root .unity-scroller > .unity-scroller__slider {
    margin: 0;
    padding: 0;
    flex-grow: 1;
}
.garage-root .unity-scroller > .unity-scroller__slider .unity-base-slider__tracker {
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.04);
}
.garage-root .unity-scroller > .unity-scroller__slider .unity-base-slider__dragger {
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.2);
}
.garage-root .unity-scroller > .unity-scroller__slider .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.34);
}
.garage-root .unity-scroller--vertical > .unity-scroller__slider .unity-base-slider__tracker,
.garage-root .unity-scroller--vertical > .unity-scroller__slider .unity-base-slider__dragger {
    left: 2px;
    width: 6px;
}
.garage-root .unity-scroller--horizontal > .unity-scroller__slider .unity-base-slider__tracker,
.garage-root .unity-scroller--horizontal > .unity-scroller__slider .unity-base-slider__dragger {
    top: 2px;
    height: 6px;
}

/* ---- Body Studio (docs/08): toolbar, shape palette, 3D view, inspector, status bar ---- */
.studio {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
}
.studio-top {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 52px;
    padding: 0 12px;
    background-color: rgba(9, 12, 17, 0.9);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.07);
}
.studio-title {
    margin: 0 14px 0 8px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(244, 246, 250);
}
.studio-group {
    flex-direction: row;
    align-items: center;
    height: 34px;
    margin-left: 6px;
    padding-left: 8px;
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
}
.studio-caption {
    margin: 0 4px;
    font-size: 11px;
    color: rgb(140, 150, 165);
}
.tool-button {
    flex-direction: row;
    align-items: center;
    height: 32px;
    margin: 0 2px;
    padding: 0 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.04);
    color: rgb(190, 198, 210);
    transition-duration: 0.1s;
}
.tool-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: rgb(255, 255, 255);
}
.tool-button:disabled {
    color: rgb(95, 102, 114);
    background-color: rgba(255, 255, 255, 0.02);
}
.tool-button--icon {
    width: 34px;
    padding: 0;
    justify-content: center;
}
.tool-button--active {
    border-color: rgba(79, 193, 255, 0.8);
    background-color: rgba(79, 193, 255, 0.2);
    color: rgb(255, 255, 255);
}
.tool-icon {
    width: 17px;
    height: 17px;
}
.tool-label {
    margin-left: 6px;
    font-size: 12px;
}
.studio-back {
    background-color: rgba(255, 255, 255, 0.08);
}
.snap-button {
    min-width: 30px;
    height: 26px;
    margin: 0 1px;
    padding: 0 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.04);
    color: rgb(200, 206, 216);
    font-size: 12px;
}
.snap-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}
.snap-button--active {
    border-color: rgb(79, 193, 255);
    background-color: rgba(79, 193, 255, 0.22);
    color: rgb(255, 255, 255);
}
.studio-main {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
}
.studio-palette {
    width: 214px;
    padding: 12px 12px 4px 12px;
    background-color: rgba(10, 13, 19, 0.88);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.07);
}
.palette-title {
    margin: 2px 0 6px 0;
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(150, 160, 175);
}
.palette-note {
    margin-bottom: 4px;
    font-size: 11px;
    color: rgb(140, 150, 165);
    white-space: normal;
}
.palette-switch {
    flex-direction: row;
    margin-bottom: 10px;
}
.switch-button {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 30px;
    margin: 0 2px;
    padding: 0 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.04);
    color: rgb(190, 198, 210);
    font-size: 12px;
}
.switch-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}
.switch-button--active {
    border-color: rgb(79, 193, 255);
    background-color: rgba(79, 193, 255, 0.2);
    color: rgb(255, 255, 255);
}
.switch-icon {
    width: 14px;
    height: 14px;
    margin-right: 5px;
}
.shape-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 6px;
}
.shape-button {
    width: 84px;
    height: 74px;
    margin: 0 0 8px 0;
    padding: 6px 4px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.04);
    color: rgb(110, 200, 255);
    transition-duration: 0.1s;
}
.shape-button:hover {
    border-color: rgba(79, 193, 255, 0.7);
    background-color: rgba(79, 193, 255, 0.1);
    translate: 0 -1px;
}
.shape-button--hole {
    color: rgb(200, 206, 218);
    border-color: rgba(200, 206, 218, 0.18);
}
.shape-icon {
    width: 30px;
    height: 30px;
    margin-bottom: 5px;
}
.shape-label {
    font-size: 11px;
    color: rgb(220, 224, 230);
    -unity-text-align: middle-center;
    white-space: normal;
}
.studio-viewport {
    flex-grow: 1;
}
/* The Tinkercad handles, painted over the 3D view (GarageHandles.cs) */
.handle-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}
.handle-reading {
    position: absolute;
    translate: -50% -50%;
    padding: 1px 6px 2px 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: #C8CDD4;
    background-color: #FFFFFF;
    color: #262626;
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}
.studio-right {
    width: 312px;
    min-height: 0;
    padding: 10px;
}
.side-panel--studio {
    max-height: none;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}
.side-panel--studio > .side-header {
    display: none;
}
.side-panel--studio > .side-content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
}
.studio-status {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 30px;
    padding: 0 14px;
    background-color: rgba(9, 12, 17, 0.9);
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.07);
}
.studio-status-text {
    flex-shrink: 1;
    font-size: 11px;
    color: rgb(185, 192, 204);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.studio-stats {
    margin-left: 12px;
    font-size: 11px;
    color: rgb(120, 200, 150);
    white-space: nowrap;
}
.studio-section {
    margin: 14px 0 6px 0;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(79, 193, 255);
}
.shape-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin-bottom: 2px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.03);
}
.shape-row:hover {
    background-color: rgba(79, 193, 255, 0.12);
}
.shape-row-icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    color: rgb(110, 200, 255);
}
.shape-row-name {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(225, 229, 236);
}
.shape-row-tag {
    margin-right: 6px;
    padding: 0 6px;
    border-radius: 8px;
    background-color: rgba(200, 206, 218, 0.16);
    color: rgb(200, 206, 218);
    font-size: 10px;
}
.feature-title {
    flex-direction: row;
    align-items: center;
    margin: 2px 0 8px 0;
}
.feature-title-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    color: rgb(79, 193, 255);
}
.vec-row {
    flex-direction: row;
    margin-bottom: 2px;
}
.vec-field {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    margin: 0 3px 0 0;
}
.vec-field > .unity-label {
    min-width: 0;
    width: 12px;
    margin: 0 3px 0 0;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
}
.vec-x > .unity-label {
    color: rgb(255, 110, 110);
}
.vec-y > .unity-label {
    color: rgb(130, 225, 110);
}
.vec-z > .unity-label {
    color: rgb(110, 160, 255);
}
.vec-field .unity-base-text-field__input, .detail-field .unity-base-text-field__input {
    height: 24px;
    padding: 0 5px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 4px;
    background-color: rgb(30, 36, 48);
    color: rgb(236, 238, 243);
    -unity-text-align: middle-right;
}
.detail-field {
    margin: 6px 0 2px 0;
}
.detail-field > .unity-label {
    min-width: 0;
    margin-right: 8px;
    font-size: 12px;
    color: rgb(150, 160, 175);
}
.icon-small-button {
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
}
.small-icon {
    width: 14px;
    height: 14px;
    margin-right: 5px;
}
.body-toggle .unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.28);
    border-radius: 3px;
    background-color: rgb(30, 36, 48);
    -unity-background-image-tint-color: rgb(79, 193, 255);
}

/* ---- Body Studio library: tabs, materials, colours, parts ---- */
.studio-palette {
    flex-direction: column;
}
.library-tabs {
    flex-direction: row;
    margin-bottom: 8px;
}
.library-tab {
    flex-grow: 1;
    flex-basis: 0;
    height: 30px;
    margin: 0 2px;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(255, 255, 255, 0.03);
    color: rgb(160, 170, 185);
    font-size: 12px;
    -unity-font-style: bold;
}
.library-tab:hover {
    color: rgb(255, 255, 255);
}
.library-tab--active {
    border-bottom-color: rgb(79, 193, 255);
    color: rgb(255, 255, 255);
}
.library-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
}
.material-picker {
    margin-bottom: 8px;
}
.material-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}
.material-button {
    width: 84px;
    min-height: 28px;
    margin: 0 0 4px 0;
    padding: 3px 5px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.04);
}
.material-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}
.material-button--active {
    border-color: rgb(79, 193, 255);
    background-color: rgba(79, 193, 255, 0.18);
}
.material-chip {
    width: 14px;
    height: 14px;
    margin-right: 5px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 3px;
}
.material-chip--clear {
    opacity: 0.6;
}
/* The whole name, on two lines when it is long ("PVC foam board"), never cut short */
.material-name {
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: rgb(220, 224, 230);
    -unity-text-align: middle-left;
    white-space: normal;
}
.colour-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 2px 0 2px 0;
}
.colour-swatch {
    width: 18px;
    height: 18px;
    margin: 0 4px 4px 0;
    padding: 0;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 9px;
}
.colour-swatch--active {
    border-color: rgb(79, 193, 255);
}
.colour-clear {
    height: 18px;
    margin: 0 4px 4px 0;
    padding: 0 6px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 9px;
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(220, 224, 230);
    font-size: 10px;
}
.material-note {
    font-size: 10px;
    color: rgb(130, 140, 155);
}
.part-count {
    margin-top: 1px;
    font-size: 10px;
    color: rgb(130, 140, 155);
    -unity-text-align: middle-center;
}
.shape-button:disabled {
    opacity: 0.45;
}
.part-button {
    height: auto;
    min-height: 92px;
    flex-shrink: 0;
    justify-content: flex-start;
    padding-top: 8px;
}

/* ---- the view cube, Home and Fit (UI/ViewCube.cs, Garage/GarageCamera.cs) ---- */
.view-tools {
    position: absolute;
    width: 104px;
    align-items: center;
}
.view-tools--garage {
    top: 60px;
    left: 298px;
}
.view-tools--studio {
    top: 10px;
    left: 12px;
}
.view-cube {
    width: 104px;
    height: 104px;
}
.view-cube-label {
    position: absolute;
    translate: -50% -50%;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0.5px;
    color: rgb(52, 60, 74);
}
.view-buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 2px;
}
.view-button {
    width: 34px;
    height: 30px;
    margin: 0 3px;
    padding: 6px 8px;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(9, 12, 17, 0.72);
    color: rgb(200, 208, 220);
}
.view-button:hover {
    background-color: rgb(79, 193, 255);
    color: rgb(12, 16, 22);
}

/* ---- part pictures and icons in the panels (GaragePartPictures.cs; the owner, 2026-09-25) ---- */
.part-picture {
    color: rgb(110, 200, 255);
}
.shape-button .shape-icon.part-picture {
    width: 58px;
    height: 50px;
    margin-bottom: 2px;
}
.shape-row-icon.part-picture {
    width: 30px;
    height: 24px;
    margin: -3px 6px -3px -3px;
}
.feature-title-icon.part-picture {
    width: 52px;
    height: 44px;
}
.section-row {
    flex-direction: row;
    align-items: center;
    margin: 10px 0 6px 0;
}
.section-row > .section-title {
    margin: 0;
}
.section-icon {
    width: 15px;
    height: 15px;
    margin-right: 6px;
    color: rgb(79, 193, 255);
}
.look-button {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding: 0 8px 0 4px;
}
.look-picture {
    width: 26px;
    height: 24px;
    margin-right: 4px;
    color: rgb(110, 200, 255);
}
.seg-icon {
    width: 14px;
    height: 14px;
    margin: 0 5px 0 4px;
}
.part-row-picture {
    width: 34px;
    height: 28px;
    margin-right: 8px;
    flex-shrink: 0;
    color: rgb(110, 200, 255);
}
.part-row > .part-name {
    flex-grow: 1;
}
